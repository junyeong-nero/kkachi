{
  "servers": {
    "devices": {
      "url": "http://127.0.0.1:4301/mcp",
      "command": ["bun", "services/devices/server.ts"],
      "routes": ["/device", "/api/device/", "/mcp/devices"]
    },
    "memory": {
      "url": "http://127.0.0.1:4302/mcp",
      "command": ["bun", "services/memory/server.ts"],
      "routes": ["/mcp/memory"]
    }
  },
  "agents": {
    "chat": {
      "tools": ["devices:*", "memory:memory_move", "memory:memory_delete", "memory:memory_undo"],
      "meta": { "commit": "later" }
    },
    "librarian": {
      "tools": ["memory:memory_move", "memory:memory_delete"],
      "meta": { "commit": "later" }
    },
    "_chat": "Kkachi Home's conversation: edits notes as files; core commits each turn, so its note tools commit later",
    "_librarian": "tidies the notes in place; core commits the whole tidy as one commit"
  }
}
